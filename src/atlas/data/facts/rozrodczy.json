  {
   "id": "rozrodczy.summary.rest",
   "kind": "summary",
   "plate": "rozrodczy",
   "state": "rest",
   "textPl": "Karta pokazuje budowę układu rozrodczego mężczyzny i kobiety z boku, jak przekrój w podręczniku, w tej samej skali. U mężczyzny jądra leżą w mosznie poza miednicą, a plemniki płyną przez najądrze i nasieniowód do cewki moczowej. U kobiety jajniki, jajowody, macica i pochwa leżą w miednicy mniejszej, za pęcherzem moczowym.",
   "status": "checked_agent",
   "referenceIds": [
    "statpearls_testes",
    "statpearls_male_gu",
    "statpearls_seminal_vesicle",
    "statpearls_female_internal",
    "statpearls_uterus"
   ],
   "provenance": "textbook_consensus",
