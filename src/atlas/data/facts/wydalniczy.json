   ],
   "evidenceLevel": "probable_human",
   "quote": "RBF after maximum exercise decreased by 51% in Study 1. In Study 2, RBF showed no significant decrease until 80% LaBP, and showed a significant decrease (31%) at 100% LaBP compared with at rest (p < 0.01).",
   "locator": "Kawakami 2018, abstrakt (Results); pełny tekst Results Study 2, Fig. 2a",
   "conversionNote": "Spoczynek = 100% (punkt odniesienia badania). −31% przy 100% LaBP, −51% po wysiłku maksymalnym.",
   "protocolMismatch": "cykloergometr: etapy po 4 min kolejno 60–140% progu mleczanowego oraz test do wyczerpania (pomiar 5 min po)",
   "measuredAt": "zaraz po 4-min etapie wysiłku; −51%: 5 min po wysiłku maksymalnym",
   "tier": "primary",
   "value": "ok. −30% (do −50%)",
   "notePl": "8 zdrowych mężczyzn (23 lata), USG. Bez spadku do 80% progu mleczanowego; −31% przy 100% progu, a przy wyższych etapach dalej w dół; −51% po wysiłku do wyczerpania. Przy 88% VO₂max spadek jest więc najpewniej większy niż 31%. W innym badaniu interwały 1 min przy progu OBLA i 2 min odpoczynku nie obniżyły przepływu mierzonego po wysiłku.",
   "seeAlsoPlate": null,
   "status": "checked_agent",
   "provenance": "primary_study",
   "accessMode": "full_text",
