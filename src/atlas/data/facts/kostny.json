   "id": "kostny.metric.szczyt_nacisku_podloza_na_stope",
   "kind": "metric",
   "plate": "kostny",
   "labelPl": "Szczyt nacisku podłoża na stopę",
   "unit": "× masa ciała",
   "referenceIds": [
    "munro_1987"
   ],
   "evidenceLevel": "established_human",
   "quote": "The thrust peak, which is the second peak in the vertical GRF-histories of rear-foot strikers, generally occurred between 35 and 50% of the total stance time and its magnitude increased (p < 0.001) from 2.5 BW at 3.0 m s-1 to 2.8 BW at 5.0 m s-1.",
   "locator": "Munro 1987, s. 151, akapit „Thrust maximum”; tab. 3, wiersze 3,00–3,75 m/s (tabele sprawdzone na publicznej kopii skanu)",
   "conversionNote": "Munro 1987, tab. 3: thrust maximum 2,51 / 2,56 / 2,62 / 2,67 BW dla 3,00 / 3,25 / 3,50 / 3,75 m/s, zaokrąglone do 2,5–2,7.",
   "protocolMismatch": "pojedyncze kroki biegu ze stałą prędkością (wybieraną samodzielnie) po płycie pomiarowej, w stanie wypoczętym, nie pod koniec 45 s pracy; badanie nie podaje % VO₂max; 20 mężczyzn ok. 25 lat biegających rekreacyjnie; wzorzec 88% VO₂max ≈ 3,0–3,7 m/s (szacunek z równania biegu ACSM), czyli dolna część zakresu 3–5 m/s",
   "measuredAt": "jeden krok biegu, 35–50% czasu kontaktu stopy (szczyt opisany u lądujących na pięcie, 17 z 20 badanych)",
   "tier": "primary",
   "value": "ok. 2,5–2,7",
   "notePl": "To siła, z jaką podłoże naciska na stopę (zmierzona płytą pomiarową), a nie siła wewnątrz kości. Wartość dla tempa podobnego do naszego interwału; przy szybszym biegu nieco więcej.",
   "seeAlsoPlate": null,
   "status": "checked_agent",
