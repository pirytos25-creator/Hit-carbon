   }
  },
  {
   "id": "limfatyczny.summary.sprint",
   "kind": "summary",
   "plate": "limfatyczny",
   "state": "sprint",
   "textPl": "W wysiłku adrenalina odrywa komórki odpornościowe od ścian naczyń, więc w krwi szybko przybywa komórek NK i limfocytów. Śledziona się kurczy i oddaje krew do krążenia. Pracujące mięśnie wyciskają limfę szybciej. 1–2 godziny po wysiłku limfocytów we krwi jest przejściowo mniej niż przed nim. Naukowcy się spierają, czy to osłabia odporność, czy komórki po prostu przechodzą do tkanek.",
   "status": "checked_agent",
   "referenceIds": [
