  {
   "id": "limfatyczny.summary.rest",
   "kind": "summary",
   "plate": "limfatyczny",
   "state": "rest",
   "textPl": "Z naczyń krwionośnych wycieka do tkanek płyn tkankowy. Gdy trafi do naczyń chłonnych, staje się limfą. Naczynia chłonne prowadzą ją powoli przez węzły chłonne, które działają jak filtry. Przewód piersiowy oddaje limfę z powrotem do krwi, do żyły przy lewym obojczyku. Część komórek odpornościowych, np. komórek NK, przylega do ścian naczyń krwionośnych.",
   "status": "checked_agent",
   "referenceIds": [
    "campbell_turner_2018"
   ],
   "provenance": "primary_study",
   "accessMode": null,
   "auto": [
    "provenance"
