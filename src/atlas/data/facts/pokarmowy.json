   "checkedBy": null
  },
  {
   "id": "pokarmowy.summary.sprint",
   "kind": "summary",
   "plate": "pokarmowy",
   "state": "sprint",
   "textPl": "W sprincie jelita i żołądek dostają mniej krwi, bo krew płynie do pracujących mięśni. Przepływ przez wątrobę spada kilkukrotnie. Mimo to wątroba pracuje pełną parą: oddaje do krwi glukozę kilka razy szybciej niż w spoczynku (przy ok. 87% VO₂max 4–6 razy), więc glukozy we krwi przybywa. Część mleczanu z mięśni wątroba przerabia z powrotem na glukozę (cykl Cori).",
   "status": "checked_agent",
   "referenceIds": [
